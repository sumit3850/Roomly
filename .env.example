# Supabase project (Project Settings → API). Only the publishable/anon key belongs here.
# NEVER put the service_role key in any VITE_ variable — it would be shipped to browsers.
VITE_SUPABASE_URL=https://kbeondyuxwqiuxyjvzfr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_3WjagfKO1qnlWq-5dq4ZJA_a6lShLrM
# Public site URL used for auth email redirects (no trailing slash)
VITE_SITE_URL=http://localhost:5173
# Optional sign-in methods (true/false)
# SMS OTP requires a paid SMS provider configured in Supabase (Twilio, etc.)
VITE_ENABLE_PHONE_AUTH=false
# Google sign-in is free: enable Google in Supabase → Authentication → Providers first
VITE_ENABLE_GOOGLE_AUTH=false
